{
  "extends": "stylelint-config-standard-scss",
  "plugins": ["stylelint-scss"],
  "rules": {
    "scss/dollar-variable-pattern": null,
    "scss/at-rule-no-unknown": null,
    "declaration-property-value-no-unknown": [true, {
      "ignoreProperties": {
        "background": ["/^url/"]
      }
    }]
  }
}
